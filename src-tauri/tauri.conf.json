{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model SDK Workbench",
  "version": "0.1.0",
  "identifier": "com.modelsdk.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Model SDK 调试台", "width": 1320, "height": 820, "minWidth": 920, "minHeight": 620 }],
    "security": { "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": { "active": true, "targets": "nsis" }
}
